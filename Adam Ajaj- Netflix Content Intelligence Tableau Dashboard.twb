      <column caption='Movie Count' datatype='integer' name='[Calculation_952229903780745217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [type] = &quot;Movie&quot;&#10;    THEN [show_id]&#10;    END&#10;)' />
